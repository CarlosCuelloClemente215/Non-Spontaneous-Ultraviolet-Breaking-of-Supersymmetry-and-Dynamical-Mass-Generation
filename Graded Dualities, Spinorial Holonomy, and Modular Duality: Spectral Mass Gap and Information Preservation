\section{Graded Fock Modules and Fredholm Supertrace Invariants}

Let $\Hilb_1 = \Hilb_1^{(0)} \oplus \Hilb_1^{(1)}$ be a separable $\Z_2$-graded complex Hilbert space. Its completed $\Z_2$-graded Fock module is given by
\begin{equation}
    \Hilb = \Hilb_B \oplus \Hilb_F = \left( \bigoplus_{k=0}^\infty \bigvee^k \Hilb_1^{(0)} \right) \oplus \left( \bigoplus_{k=0}^\infty \bigwedge^k \Hilb_1^{(1)} \right),
\end{equation}
equipped with the unitary grading involution $\gamma = (-1)^F = I_{\Hilb_B} \oplus (-I_{\Hilb_F})$ and the dense finite-particle algebraic core $\Hilb_{\mathrm{fin}} = \bigoplus_{k=0}^{\infty,\mathrm{alg}} \left( \bigvee^k \Hilb_1^{(0)} \oplus \bigwedge^k \Hilb_1^{(1)} \right)$.

\begin{definition}[Spectral Admissibility and Grading Obstruction]

\begin{lemma}[Orientation-Reversing Integral Duality]
Let $\rho \in L^1(\R, dx) \cap C^\infty(\R)$ be an even, strictly positive probability density satisfying $\int_{-\infty}^{+\infty} \rho(x)\,dx = 1$ (for instance, the heat kernel $\rho_\varepsilon(x) = (4\pi\varepsilon)^{-1/2} e^{-x^2/(4\varepsilon)}$, which converges weak-$^*$ in $\mathcal{S}'(\R)$ to $\delta_0$ as $\varepsilon \to 0^+$). Under the orientation reversal of the integration domain $\R \mapsto -\R$ induced by the coordinate reflection $x \mapsto -x$, we have
\begin{equation}
    \int_{+\infty}^{-\infty} \rho(x)\,dx = -\int_{-\infty}^{+\infty} \rho(x)\,dx = -1 \equiv 1 \pmod 2.
\end{equation}
\end{lemma}

\begin{proof}
By linearity of the Lebesgue integral and the orientation-reversing change of variables $x \mapsto -x$ with Jacobian determinant $-1$, we obtain $\int_{+\infty}^{-\infty} \rho(x)\,dx = -\int_{-\infty}^{+\infty} \rho(x)\,dx = -1$. Under the canonical projection $\Z \to \Z_2$, $-1 \equiv 1 \pmod 2$, preserving the unit signed-measure parity in $\Z/2\Z$ across the dual orientation sectors indexed by $n \in \{-1, +1\}$.
\end{proof}

\section{Dirac Kernel Dynamics and the Non-Vanishing Spectral Trace Theorem}

Let $(\mathcal{M}, g)$ be a four-dimensional globally hyperbolic, asymptotically flat spin manifold admitting a $\mathrm{Spin}(1, 3)$ structure, and let $\mathcal{S} \to \mathcal{M}$ be the associated complex Dirac spinor bundle of rank $4$. Let $\slashed{D} = i\gamma^\mu \nabla_\mu - m = i\slashed{\partial} - m$ denote the massive Dirac operator acting on smooth compactly supported sections $\psi \in \Gamma_c^\infty(\mathcal{M}, \mathcal{S})$, where $\{\gamma^\mu, \gamma^\nu\} = 2g^{\mu\nu} I_4$. Restoring $\hbar$ explicitly, fix a unit positive-energy spinor polarization $u_+ \in \C^4$ ($u_+^\dagger u_+ = 1$) and a normalized longitudinal profile $\chi_0 \in \mathcal{S}(\R)$ ($\|\chi_0\|_{L^2(\R)} = 1$) in an asymptotically Euclidean chart $(x, y, z) \in \R^3$ on a Cauchy hypersurface $\Sigma_t$ ($r = \sqrt{x^2+y^2+z^2} \ge r_0$), and define the partial-isometric Foldy--Wouthuysen dimensional reduction map $\Pi_{\mathrm{FW}} : L^2(\Sigma_t, \mathcal{S}|_{\Sigma_t}) \to L^2(\R^2)$ by
\begin{equation}
    (\Pi_{\mathrm{FW}}\psi)(x, y) = \int_{-\infty}^{+\infty} \overline{\chi_0(z)}\, u_+^\dagger \psi(x, y, z)\,dz.
\end{equation}
For any normalized state $\phi \in \mathcal{S}(\R^2)$, denote by $\Delta_\phi x = \|(x - \langle \phi, x\phi \rangle)\phi\|_{L^2(\R^2)}$ and $\Delta_\phi p_x = \|(p_x - \langle \phi, p_x\phi \rangle)\phi\|_{L^2(\R^2)}$ the operational standard deviations of position and canonical momentum $p_x = -i\hbar\partial_x$.

We now establish a quantitative spectral lower bound governing stationary spinorial kernel modes restricted to a reduced effective Hamiltonian without assuming strict positivity a priori.

\begin{theorem}[Quantitative Spectral Lower Bound under Heisenberg Constraints]\label{thm:nonvanishing-trace}
Let $\{\psi_{n,r}\}_{n \in \{-1, 1\}, \, r \ge r_0} \subset \Ker(i\slashed{\partial} - m) \cap L^2(\Sigma_t, \mathcal{S}|_{\Sigma_t})$ be a family of stationary spinor fields indexed by the binary parity parameter $n \in \{-1, 1\}$ and asymptotic radial scale $r \ge r_0$ such that the reduced states $\phi_{n,r} = \Pi_{\mathrm{FW}}\psi_{n,r} \in \mathcal{S}(\R^2)$ form an orthonormal pair in $L^2(\R^2)$ for each $r \ge r_0$ and satisfy the uniform spatial localization bound
\begin{equation}
    0 < \Delta_{\phi_{n,r}} x \le \Delta B < \infty \quad \text{uniformly as } r \to \infty
\end{equation}
for a fixed constant $\Delta B > 0$. Let $H = \frac{1}{2M}(p_x^2 + p_y^2) + V(x, y)$ ($M > 0$, $V \in L^2_{\mathrm{loc}}(\R^2)$ non-negative and polynomially bounded) be a self-adjoint effective Hamiltonian on $L^2(\R^2)$ satisfying $[x, p_x] = i\hbar I$ on the common invariant Schwartz core $\mathcal{S}(\R^2) \subset \Dom(x) \cap \Dom(p_x) \cap \Dom(H)$ and the Robertson--Heisenberg uncertainty inequality $\Delta_\phi x \, \Delta_\phi p_x \ge \frac{\hbar}{2} > 0$ for all normalized $\phi \in \mathcal{S}(\R^2)$. Setting $\Hilb_{\mathrm{red}}(r) = \operatorname{span}\{\phi_{-1,r}, \phi_{+1,r}\} \subset \mathcal{S}(\R^2)$, the restricted spectral trace is strictly positive and uniformly bounded below as $r \to \infty$:
\begin{equation}
    \liminf_{r \to \infty} \Tr_{\Hilb_{\mathrm{red}}(r)}(H) = \liminf_{r \to \infty} \sum_{n \in \{-1, 1\}} \langle \phi_{n,r}, H \phi_{n,r} \rangle \ge \frac{\hbar^2}{4M(\Delta B)^2} > 0.
\end{equation}
\end{theorem}

\begin{proof}
We proceed in three steps:

\textbf{Step 1 (Lower bound from canonical uncertainty).} For each $r \ge r_0$ and each normalized basis state $\phi_{n,r} \in \mathcal{S}(\R^2)$ ($n \in \{-1, 1\}$), define the centered symmetric operators $\tilde{x} = x - \langle \phi_{n,r}, x \phi_{n,r} \rangle I$ and $\tilde{p}_x = p_x - \langle \phi_{n,r}, p_x \phi_{n,r} \rangle I$ on $\mathcal{S}(\R^2)$. By the Cauchy--Schwarz inequality,
\begin{equation}
    (\Delta_{\phi_{n,r}} x)^2 (\Delta_{\phi_{n,r}} p_x)^2 = \|\tilde{x}\phi_{n,r}\|^2 \|\tilde{p}_x\phi_{n,r}\|^2 \ge |\langle \tilde{x}\phi_{n,r}, \tilde{p}_x\phi_{n,r} \rangle|^2 \ge \left( \frac{1}{2i} \langle \phi_{n,r}, [\tilde{x}, \tilde{p}_x]\phi_{n,r} \rangle \right)^2 = \frac{\hbar^2}{4}.
\end{equation}
Since $0 < \Delta_{\phi_{n,r}} x \le \Delta B < \infty$ uniformly for $r \ge r_0$, it follows that $(\Delta_{\phi_{n,r}} p_x)^2 \ge \frac{\hbar^2}{4(\Delta B)^2} > 0$ uniformly as $r \to \infty$.

\textbf{Step 2 (Strict positivity of diagonal expectation values).} Because $V \in L^2_{\mathrm{loc}}(\R^2)$ is non-negative and polynomially bounded, $\mathcal{S}(\R^2) \subset \Dom(H)$ and the quadratic form of $H = \frac{1}{2M}(p_x^2 + p_y^2) + V(x, y)$ evaluated on each normalized basis state $\phi_{n,r} \in \mathcal{S}(\R^2)$ ($n \in \{-1, 1\}$) yields
\begin{equation}
    \lambda_{n,r} = \langle \phi_{n,r}, H \phi_{n,r} \rangle \ge \frac{1}{2M} \langle \phi_{n,r}, p_x^2 \phi_{n,r} \rangle \ge \frac{1}{2M} (\Delta_{\phi_{n,r}} p_x)^2 \ge \frac{\hbar^2}{8M(\Delta B)^2} > 0.
\end{equation}

\textbf{Step 3 (Uniform lower bound on $\Hilb_{\mathrm{red}}(r)$).} Because $\phi_{n,r}$ is stationary with respect to the unitary time evolution generated by $H$ ($\partial_t \langle \phi_{n,r}, H \phi_{n,r} \rangle = 0$), summing over the orthonormal basis $\{\phi_{-1,r}, \phi_{+1,r}\}$ of $\Hilb_{\mathrm{red}}(r)$ gives
\begin{equation}
    \Tr_{\Hilb_{\mathrm{red}}(r)}(H) = \lambda_{-1,r} + \lambda_{+1,r} \ge \frac{\hbar^2}{4M(\Delta B)^2} > 0
\end{equation}
for all $r \ge r_0$. Taking the limit inferior as $r \to \infty$ establishes the uniform quantitative spectral lower bound.
\end{proof}

\begin{corollary}[Incompatibility with Null Spectral Collapse]
Under the hypotheses of Theorem~\ref{thm:nonvanishing-trace}, no family of unitary transformations $U_r$ preserving both the canonical commutation relations $[x, p_x] = i\hbar I$ on $\mathcal{S}(\R^2)$ and the reduced subspaces ($U_r(\Hilb_{\mathrm{red}}(r)) = \Hilb_{\mathrm{red}}(r)$) can map the restricted Hamiltonian $H|_{\Hilb_{\mathrm{red}}(r)}$ to the zero operator in the stationary asymptotic limit $r \to \infty$.
\end{corollary}

\begin{proof}
Since $U_r$ leaves $\Hilb_{\mathrm{red}}(r)$ invariant, the restricted trace $\Tr_{\Hilb_{\mathrm{red}}(r)}(H)$ is a unitary invariant. By Theorem~\ref{thm:nonvanishing-trace}, $\liminf_{r \to \infty} \Tr_{\Hilb_{\mathrm{red}}(r)}(U_r H U_r^*) = \liminf_{r \to \infty} \Tr_{\Hilb_{\mathrm{red}}(r)}(H) \ge \frac{\hbar^2}{4M(\Delta B)^2} > 0$, excluding asymptotic collapse to the zero operator.
\end{proof}

\section{Ghost-Free Unitarity, Confined Quantum Vacua, and Asymptotic Minkowski Limits}

A fundamental obstruction in non-cyclic cosmological models and naive perturbative quantum field theories is the appearance of negative-norm states (ghosts), spurious zeros, and non-integrable infrared/ultraviolet divergences when extrapolating toward a single initial singularity. To address this within our $\mathbb{Z}_2$-graded framework, we formulate a topological confinement condition on the physical state space.

Let $(\mathcal{M}^4, g)$ be a four-dimensional Lorentzian spin manifold admitting an asymptotically flat limit $g_{\mu\nu} \to \eta_{\mu\nu}$ (the Minkowski metric with signature $(+,-,-,-)$) along a critical boundary hypersurface $\partial \mathcal{M}_c$.

\begin{definition}[Ghost-Free Confined Vacuum Sector]\label{def:ghost-free}
A quantum field theory defined on $(\mathcal{M}^4, g)$ is said to possess a \emph{ghost-free confined vacuum sector} $\mathcal{H}_{\mathrm{conf}} = \bigoplus_{N=0}^\infty \mathcal{H}_{\mathrm{conf}}^{(N)} \subset \mathcal{H}$ (graded by particle number $N$, with vacuum ray $\mathcal{H}_{\mathrm{conf}}^{(0)} = \C\Omega_0$) if:
\begin{enumerate}[label=(\roman*)]
    \item \emph{Positivity of the inner product (Unitarity):} The sesquilinear form $\langle \cdot, \cdot \rangle_{\mathcal{H}_{\mathrm{conf}}}$ is strictly positive definite, excluding negative-norm ghost excitations ($\|\psi_{\mathrm{ghost}}\|^2 < 0$).
    \item \emph{Supersymmetric spectral pairing:} For every strictly positive eigenvalue $E > 0$ of the total self-adjoint Hamiltonian $H_{\mathrm{tot}} = Q^2 \ge 0$, the odd self-adjoint supercharge $Q$ defines a unitary isomorphism between the bosonic eigenspace $\mathcal{H}_B(E)$ and the fermionic eigenspace $\mathcal{H}_F(E)$, forcing $\dim \mathcal{H}_B(E) = \dim \mathcal{H}_F(E)$ and hence $\operatorname{Str}(H_{\mathrm{tot}}^k e^{-s H_{\mathrm{tot}}}) = 0$ for all $k \ge 1$ and $s > 0$.
    \item \emph{Cyclic unitary extension:} Because $H_{\mathrm{tot}}$ is self-adjoint on a $\tau$-invariant domain, the one-parameter unitary group $U(t) = \exp(-it H_{\mathrm{tot}}/\hbar)$ extends across the asymptotic dual equivalence $\omega_1 \sim_\tau \omega_0$ via a unitary transition operator $S_{\mathrm{cyc}} \in \mathcal{U}(\mathcal{H}_{\mathrm{conf}})$ intertwining the asymptotic GNS sectors and preserving the von Neumann entropy $S_{\mathrm{vN}}(\rho) = -\Tr_{\mathcal{H}_{\mathrm{conf}}}(\rho \ln \rho)$.
\end{enumerate}
\end{definition}

\section{Spectral Gap via $\pi$-Radial Compactification}

