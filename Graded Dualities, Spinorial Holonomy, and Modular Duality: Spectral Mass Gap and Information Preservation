\section{Graded Involutions and Boundary Quotient Dualities}

Let $\mathcal{U}^1_\infty \hookrightarrow \mathcal{U}^0_\infty$ denote the dense inclusion of a locally compact Hausdorff manifold into a compact Hausdorff boundary completion $\mathcal{U}^0_\infty$. Because $1_{\mathcal{A}} \in \mathcal{A}_0$ and every state $\omega \in \mathcal{S}(\mathcal{A})$ satisfies $\omega(1_{\mathcal{A}}) = 1$, no positive state can vanish identically on $\mathcal{A}_0$; accordingly, dual odd functionals live naturally in $\mathcal{A}_1^*$.

\begin{definition}[Asymptotic Dual Equivalence]\label{def:asymp-dual-pure}
Let $\tau : \mathcal{A} \to \mathcal{A}$ be a conjugate-linear isometric involution ($\tau^2 = \id_{\mathcal{A}}$) commuting with the $C^*$-involution ($\tau(a^*) = \tau(a)^*$ for all $a \in \mathcal{A}$) and anticommuting with the grading ($\tau \circ \Gamma = -\Gamma \circ \tau$), so that $\tau(\mathcal{A}_0) = \mathcal{A}_1$ and $\tau(\mathcal{A}_1) = \mathcal{A}_0$. Let $\{\omega_1(\varepsilon)\}_{\varepsilon > 0} \subset \mathcal{S}(\mathcal{A}) \cap \mathcal{A}_0^*$ be a net of even states ($\omega_1(\varepsilon)|_{\mathcal{A}_1} = 0$) and let $\{\varphi_0(\varepsilon)\}_{\varepsilon > 0} \subset \mathcal{A}_1^*$ be a net of odd Hermitian bounded linear functionals ($\varphi_0(\varepsilon)|_{\mathcal{A}_0} = 0$, $\varphi_0(\varepsilon)(a^*) = \overline{\varphi_0(\varepsilon)(a)}$). They are said to be \emph{asymptotically dually equivalent}, written $\omega_1 \sim_\tau \varphi_0$, if
\begin{equation}
    \lim_{\varepsilon \to 0^+} \left\| \overline{\omega_1(\varepsilon) \circ \tau} - \varphi_0(\varepsilon) \right\|_{\mathcal{A}^*} = 0,
\end{equation}
where $\|\cdot\|_{\mathcal{A}^*}$ denotes the dual Banach norm on $\mathcal{A}^*$ and $\overline{\omega_1(\varepsilon) \circ \tau}(a) := \overline{\omega_1(\varepsilon)(\tau(a))}$ defines a $\C$-linear Hermitian functional in $\mathcal{A}_1^*$.
\end{definition}

\begin{proposition}[Parity Eigenspace Decomposition and Isometric Isomorphism]
Let $\tau : \mathcal{A} \to \mathcal{A}$ be as in Definition~\ref{def:asymp-dual-pure}, and define the real parity-symmetric and parity-antisymmetric subspaces $\mathcal{Z}_\pm = \Ker(\tau \mp \id_{\mathcal{A}}) \subset \mathcal{A}$. Then:
\begin{enumerate}[label=(\roman*)]
    \item $\mathcal{A}$ admits the direct real Banach-space decomposition $\mathcal{A} = \mathcal{Z}_+ \oplus \mathcal{Z}_-$ with $\mathcal{A}_0 \cap \mathcal{Z}_\pm = \{0\}$ and $\mathcal{A}_1 \cap \mathcal{Z}_\pm = \{0\}$.
    \item Multiplication by the imaginary unit $J(a) = ia$ induces an isometric real-linear Banach-space isomorphism
    \begin{equation}
        J|_{\mathcal{Z}_+} : \mathcal{Z}_+ \xrightarrow{\;\sim\;} \mathcal{Z}_-,
    \end{equation}
    while preserving the exact non-triviality of the unital ring structure ($1_{\mathcal{A}} \in \mathcal{A}_0 \setminus \{0\}$).
\end{enumerate}
\end{proposition}

\begin{proof}
For (i), since $\tau^2 = \id_{\mathcal{A}}$ and $\tau$ is conjugate-linear and isometric, the bounded real-linear operators $P_\pm = \frac{1}{2}(\id_{\mathcal{A}} \pm \tau)$ are complementary projections ($P_\pm^2 = P_\pm$, $P_+ P_- = P_- P_+ = 0$, $P_+ + P_- = \id_{\mathcal{A}}$) onto $\mathcal{Z}_\pm$, yielding $\mathcal{A} = \mathcal{Z}_+ \oplus \mathcal{Z}_-$. If $a \in \mathcal{A}_0 \cap \mathcal{Z}_\pm$, then $\pm a = \tau(a) \in \tau(\mathcal{A}_0) = \mathcal{A}_1$, so $a \in \mathcal{A}_0 \cap \mathcal{A}_1 = \{0\}$; similarly, $\mathcal{A}_1 \cap \mathcal{Z}_\pm = \{0\}$.

For (ii), for every $a \in \mathcal{Z}_+$, conjugate-linearity of $\tau$ gives $\tau(ia) = -i\tau(a) = -ia$, so $ia \in \mathcal{Z}_-$. Conversely, if $b \in \mathcal{Z}_-$, then $-ib \in \mathcal{Z}_+$ with $J(-ib) = b$, and $\|ia\|_{\mathcal{A}} = \|a\|_{\mathcal{A}}$, proving that $J|_{\mathcal{Z}_+}$ is an $\R$-linear isometric isomorphism. Finally, $1_{\mathcal{A}} \in \mathcal{A}_0$ remains strictly non-zero since $\Gamma(1_{\mathcal{A}}) = 1_{\mathcal{A}}$.
\end{proof}

\begin{definition}[Conjugate Boundary Strata]
Let $\{\mathcal{M}_n\}_{n \in \{-1, +1\}}$ be a pair of smooth pseudo-Riemannian spin manifolds equipped with an isometric embedding $\mathcal{M}_{+1} \hookrightarrow \mathcal{M}_{-1}$ into a common Hausdorff completion $\overline{\mathcal{M}}$, and let $\overline{\mathcal{M}}_n$ denote the closure of $\mathcal{M}_n$ in $\overline{\mathcal{M}}$. We define the \emph{conjugate boundary strata} $\partial_- \mathcal{M} = \overline{\mathcal{M}}_{-1} \setminus \mathcal{M}_{-1}$ and $\partial_+ \mathcal{M} = \overline{\mathcal{M}}_{+1} \setminus \mathcal{M}_{+1}$, coupled algebraically via the parity-antisymmetric kernel $\mathcal{Z}_- = \Ker(\tau + \id_{\mathcal{A}})$.
\end{definition}

